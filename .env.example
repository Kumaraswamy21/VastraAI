# Local Docker Compose database; override for a hosted PostgreSQL/pgvector instance.
# Hosted connections may require sslmode=require. Compose overrides this host URL for its backend container.
DATABASE_URL=postgresql://vastraai:vastraai_local@localhost:5432/vastraai?sslmode=disable

# Generation: Gemini primary, Ollama Gemma fallback
GEMINI_API_KEY=
# Optional alias used by the google-genai SDK if GEMINI_API_KEY is empty
GOOGLE_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma2:9b
GENERATION_PROVIDER=gemini
# Optional; leave blank to disable runtime generation fallback.
GENERATION_FALLBACK_PROVIDER=
GENERATION_MODEL=gemini-2.5-flash-lite
GENERATION_TIMEOUT_SECONDS=15
GENERATION_MAX_RETRIES=1
OLLAMA_GENERATION_MODEL=gemma2:9b
OLLAMA_TIMEOUT_SECONDS=30

# Embeddings: Gemini or Ollama. Product/query vectors must use the same provider/model.
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768
EMBEDDING_BATCH_SIZE=16
EMBEDDING_MAX_RETRIES=3
EMBEDDING_TIMEOUT_SECONDS=30
EMBEDDING_STALE_PROCESSING_MINUTES=30
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# Must equal the actual output size of the selected Ollama model.
OLLAMA_EMBEDDING_DIMENSIONS=768

# Constraint extraction: Gemini structured output with deterministic fallback
SEARCH_PARSER_MODEL=gemini-2.5-flash-lite
SEARCH_PARSER_TEMPERATURE=0
SEARCH_PARSER_TIMEOUT_SECONDS=10
SEARCH_PARSER_MAX_RETRIES=1
MARKET_CURRENCY=INR

# Optional Shopify Global Catalog MCP search. Use Dev Dashboard credentials
# and a UCP profile that advertises catalog search and Shopify global catalog.
SHOPIFY_CATALOG_ENABLED=false
SHOPIFY_MCP_URL=https://catalog.shopify.com/api/ucp/mcp
SHOPIFY_TOKEN_URL=https://api.shopify.com/auth/access_token
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_AGENT_PROFILE_URL=
SHOPIFY_CATALOG_COUNTRY=IN
SHOPIFY_MCP_TIMEOUT_SECONDS=10
SHOPIFY_RAG_MODEL=gemini-3.5-flash-lite

# Hybrid search RRF (starting defaults; tune with representative queries)
HYBRID_RRF_K=60
HYBRID_SEMANTIC_WEIGHT=0.6
HYBRID_KEYWORD_WEIGHT=0.4
HYBRID_CANDIDATE_LIMIT=100
RAG_ENABLED=true
RAG_CONTEXT_TOP_K=5
RAG_DESCRIPTION_MAX_CHARS=360
SEARCH_STRONG_SEMANTIC_THRESHOLD=0.75
SEARCH_WEAK_SEMANTIC_THRESHOLD=0.35
SEARCH_MIN_KEYWORD_SIGNAL=0.01
SEARCH_DIAGNOSTICS_ENABLED=true

# App
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LOG_LEVEL=INFO
BACKEND_API_URL=http://127.0.0.1:8000
NEXTAUTH_URL=http://localhost:3000
# Generate two different random secrets of at least 32 characters; use the same AUTH_JWT_SECRET in frontend and backend.
NEXTAUTH_SECRET=
AUTH_JWT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH_FRONTEND_URL=http://localhost:3000
AUTH_EMAIL_FROM=
AUTH_SMTP_HOST=
AUTH_SMTP_PORT=587
AUTH_SMTP_USERNAME=
AUTH_SMTP_PASSWORD=
AUTH_SMTP_STARTTLS=true
# Comma-separated verified account emails allowed to view observability.
AUTH_ADMIN_EMAILS=

# Application-level AI/search observability. Dashboard routes are hidden in production.
APP_ENVIRONMENT=development
OBSERVABILITY_ENABLED=true
OBSERVABILITY_RETENTION_DAYS=30
OBSERVABILITY_STORE_RAW_QUERIES=false
OBSERVABILITY_DASHBOARD_ENABLED=true
# Optional versioned pricing; keep empty when pricing is unknown.
OBSERVABILITY_PRICING_JSON={"models":[]}
