# PostgreSQL (pgvector image via docker-compose)
DATABASE_URL=postgresql+psycopg://fashion:fashion@localhost:5432/fashion_search

# Generation: Gemini primary, Ollama Gemma fallback
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma2:9b

# Embeddings: local sentence-transformers (default) or gemini
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# App
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
