# Neon PostgreSQL (SSL required). Replace with your project connection string.
# Use the SQLAlchemy psycopg driver prefix and sslmode=require.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR_NEON_HOST/DATABASE?sslmode=require

# Generation: Gemini primary, Ollama Gemma fallback
GEMINI_API_KEY=
# Optional alias used by the google-genai SDK if GEMINI_API_KEY is empty
GOOGLE_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma2:9b

# Embeddings: Google Gemini only (hosted API; no local model weights)
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768
EMBEDDING_BATCH_SIZE=16
EMBEDDING_MAX_RETRIES=3
EMBEDDING_STALE_PROCESSING_MINUTES=30

# Constraint extraction: Gemini structured output with deterministic fallback
SEARCH_PARSER_MODEL=gemini-2.5-flash-lite
SEARCH_PARSER_TEMPERATURE=0
SEARCH_PARSER_TIMEOUT_SECONDS=10
SEARCH_PARSER_MAX_RETRIES=1
MARKET_CURRENCY=INR

# App
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
NEXT_PUBLIC_API_URL=http://localhost:8000
