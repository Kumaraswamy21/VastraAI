# Neon PostgreSQL (SSL required). Replace with your project connection string.
# Use the SQLAlchemy psycopg driver prefix and sslmode=require.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR_NEON_HOST/DATABASE?sslmode=require

# Generation: Gemini primary, Ollama Gemma fallback
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma2:9b

# Embeddings: local sentence-transformers (default) or gemini
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# App
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
NEXT_PUBLIC_API_URL=http://localhost:8000
